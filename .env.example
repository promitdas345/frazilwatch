# FrazilWatch — environment secrets
# Copy to .env and fill all values before running orchestrate commands.
# Source: IBM Cloud console → watsonx.ai → Developer Access panel
# NEVER commit .env — it is gitignored.

# ---- watsonx.ai (Granite inference) ----
WATSONX_APIKEY=your_ibm_cloud_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ---- watsonx Orchestrate Developer Edition ----
WO_DEVELOPER_EDITION_SOURCE=orchestrate
WO_INSTANCE=https://your-instance.orchestrate.ibm.com
WO_API_KEY=your_ibm_cloud_api_key_here
